---
import { Image } from 'astro:assets';
import logoWhite from '../assets/brand/logo-white.png';
import Icon from './Icon.astro';
import { site, nav, whatsappLink, fullAddress } from '../data/site';
import { categories } from '../data/content';

const year = new Date().getFullYear();
const socialIcon = (label: string) => label.toLowerCase() as 'instagram' | 'facebook' | 'youtube';
---

<footer class="ftr dark">
  <div class="wrap">
    <div class="ftr__top">
      <p class="ftr__line">Your dream home, beautifully designed.</p>
      <div class="actions">
        <a class="btn btn--sand" href="/contact#enquiry">Get a free estimate</a>
        <a class="btn btn--ghost-light" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" />WhatsApp</a>
      </div>
    </div>

    <div class="ftr__grid">
      <div class="ftr__about">
        <p>Complete home interiors for apartments, villas and independent homes, designed around the people who live in them.</p>
        <ul class="ftr__social" role="list">
          {
            site.socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
                  <Icon name={socialIcon(s.label)} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <nav aria-label="Footer">
        <h2>Explore</h2>
        <ul role="list">{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
      </nav>
      <div>
        <h2>What we design</h2>
        <ul role="list">{categories.map((c) => <li><a href={`/services#${c.id}`}>{c.name}</a></li>)}</ul>
      </div>
      <div>
        <h2>Visit or call</h2>
        <ul role="list">
          <li><a href={site.phoneHref}>{site.phoneDisplay}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>{fullAddress()}</li>
          <li>{site.hours[0].days}, {site.hours[0].time}</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="ftr__mark" aria-hidden="true">
    <Image src={logoWhite} alt="" width={1400} />
  </div>

  <div class="wrap ftr__base">
    <p>© {year} {site.legalName}</p>
    <ul role="list">
      <li><a href="/privacy-policy">Privacy Policy</a></li>
      <li><a href="/terms">Terms &amp; Conditions</a></li>
    </ul>
  </div>
</footer>

<style>
  .ftr {
    position: relative;
    overflow: hidden;
    padding-top: clamp(4rem, 3rem + 4vw, 7rem);
    font-size: var(--fs-sm);
    color: rgba(247, 239, 232, 0.72);
  }
  .ftr a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }
  .ftr a:hover {
    color: var(--cream);
  }
  .ftr ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }
  .ftr__top {
    display: grid;
    gap: 2rem;
    padding-bottom: clamp(3rem, 2rem + 3vw, 5rem);
    border-bottom: 1px solid var(--line-dark);
  }
  @media (min-width: 900px) {
    .ftr__top {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }
  .ftr__line {
    margin: 0;
    max-width: 16ch;
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    line-height: 1.04;
    letter-spacing: -0.015em;
    color: var(--cream);
  }
  .ftr__grid {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(3rem, 2rem + 3vw, 4.5rem);
  }
  @media (min-width: 640px) {
    .ftr__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1024px) {
    .ftr__grid {
      grid-template-columns: 1.5fr 0.8fr 1fr 1.2fr;
    }
  }
  .ftr h2 {
    margin-bottom: 1rem;
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--sand);
  }
  .ftr__about p {
    max-width: 34ch;
  }
  .ftr__social {
    display: flex !important;
    gap: 0.5rem !important;
    margin-top: 1.5rem !important;
  }
  .ftr__social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-dark);
    border-radius: 50%;
  }
  .ftr__social a:hover {
    background: var(--cream);
    color: var(--espresso);
  }
  .ftr__social :global(svg) {
    width: 19px;
    height: 19px;
  }

  .ftr__mark {
    padding-inline: var(--gutter);
    max-width: calc(var(--max) + var(--gutter) * 2);
    margin-inline: auto;
    opacity: 0.07;
    pointer-events: none;
  }
  .ftr__mark :global(img) {
    width: 100%;
    height: auto;
  }
  .ftr__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem 2rem;
    font-size: var(--fs-xs);
  }
  .ftr__base p {
    margin: 0;
  }
  .ftr__base ul {
    display: flex;
    gap: 1.5rem;
  }
  @media (max-width: 860px) {
    .ftr__base {
      padding-bottom: calc(2rem + 64px);
    }
  }
</style>
