---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site, nav, whatsappLink, fullAddress } from '../data/site';
import { categories } from '../data/content';

const year = new Date().getFullYear();
const socialIcon = (label: string) => label.toLowerCase() as 'instagram' | 'facebook' | 'youtube' | 'pinterest' | 'linkedin';
---

<footer class="ftr dark">
  <div class="wrap">
    <div class="ftr__top">
      <p class="ftr__line">Your dream home, beautifully designed.</p>
      <div class="actions">
        <a class="btn btn--sand" href="/contact#enquiry">Get a free estimate</a>
        <a class="btn btn--ghost-light" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" />WhatsApp</a>
      </div>
    </div>

    <div class="ftr__grid">
      <div class="ftr__about">
        <p>Complete home interiors for apartments, villas and independent homes, designed around the people who live in them.</p>
        <p class="ftr__follow">Follow our work</p>
        <ul class="ftr__social" role="list">
          {
            site.socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener" aria-label={`Elara Interiors on ${s.label}`} title={s.label}>
                  <Icon name={socialIcon(s.label)} />
                </a>
              </li>
            ))
          }
          <li>
            <a href={whatsappLink()} target="_blank" rel="noopener" aria-label="Chat with Elara Interiors on WhatsApp" title="WhatsApp">
              <Icon name="whatsapp" />
            </a>
          </li>
        </ul>
      </div>
      <nav aria-label="Footer">
        <h2>Explore</h2>
        <ul role="list">{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
      </nav>
      <div>
        <h2>What we design</h2>
        <ul role="list">{categories.map((c) => <li><a href={`/services#${c.id}`}>{c.name}</a></li>)}</ul>
      </div>
      <div>
        <h2>Visit or call</h2>
        <ul role="list">
          <li><a href={site.phoneHref}>{site.phoneDisplay}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>{fullAddress()}</li>
          <li>{site.hours[0].days}, {site.hours[0].time}</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="ftr__mark" aria-hidden="true">
    <Logo />
  </div>

  <div class="wrap ftr__base">
    <p>© {year} {site.legalName}</p>
    <ul role="list">
      <li><a href="/privacy-policy">Privacy Policy</a></li>
      <li><a href="/terms">Terms &amp; Conditions</a></li>
    </ul>
  </div>
</footer>

<style>
  .ftr {
    position: relative;
    overflow: hidden;
    padding-top: clamp(4rem, 3rem + 4vw, 7rem);
    font-size: var(--fs-sm);
    color: rgba(247, 239, 232, 0.72);
  }
  .ftr a:not(.btn) {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }
  .ftr a:not(.btn):hover {
    color: var(--cream);
  }
  .ftr ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }
  .ftr__top {
    display: grid;
    gap: 2rem;
    padding-bottom: clamp(2rem, 1.5rem + 1.5vw, 3rem);
    border-bottom: 1px solid var(--line-dark);
  }
  @media (min-width: 900px) {
    .ftr__top {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }
  .ftr__line {
    margin: 0;
    max-width: 16ch;
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    line-height: 1.04;
    letter-spacing: -0.015em;
    color: var(--cream);
  }
  .ftr__grid {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(4.5rem, 3rem + 4.5vw, 7rem) clamp(3rem, 2rem + 3vw, 4.5rem);
  }
  @media (min-width: 640px) {
    .ftr__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1024px) {
    .ftr__grid {
      grid-template-columns: 1.5fr 0.8fr 1fr 1.2fr;
    }
  }
  .ftr h2 {
    margin-bottom: 1rem;
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--sand);
  }
  .ftr__about p {
    max-width: 34ch;
  }
  .ftr__follow {
    margin: 1.75rem 0 0.75rem;
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    color: var(--sand);
  }
  .ftr__social {
    display: flex !important;
    flex-wrap: wrap;
    gap: 0.6rem !important;
  }
  .ftr__social a {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid rgb(188 154 119 / 0.55);
    border-radius: 50%;
    color: var(--cream) !important;
    transition:
      background-color 0.25s var(--ease),
      color 0.25s var(--ease),
      transform 0.25s var(--ease);
  }
  .ftr__social a:hover {
    background: var(--sand);
    border-color: var(--sand);
    color: var(--espresso) !important;
    transform: translateY(-2px);
  }
  .ftr__social :global(svg) {
    width: 20px;
    height: 20px;
  }

  /* Faint watermark behind the footer menus (no space of its own), sized to the content width */
  .ftr > :not(.ftr__mark) {
    position: relative;
    z-index: 1;
  }
  .ftr__mark {
    --logo-main: var(--cream);
    --logo-accent: var(--cream);
    position: absolute;
    left: 50%;
    bottom: 0;
    width: min(calc(100% - var(--gutter)), calc(var(--max) + 22rem));
    /* crop to the ELARA letters only: the gap before "INTERIOS" sits at ~81% of the logo's height */
    aspect-ratio: 2979 / 688; /* 24-unit top padding + ELARA letters */
    overflow: hidden;
    transform: translateX(-50%);
    opacity: 0.035;
    pointer-events: none;
  }
  @media (max-width: 860px) {
    .ftr__mark {
      bottom: 62px; /* sit above the fixed mobile contact bar */
    }
  }
  .ftr__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem 2rem;
    font-size: var(--fs-xs);
  }
  .ftr__base p {
    margin: 0;
  }
  .ftr__base ul {
    display: flex;
    gap: 1.5rem;
  }
  @media (min-width: 861px) {
    .ftr__base {
      padding-right: calc(var(--gutter) + 4.5rem); /* clear the floating WhatsApp button */
    }
  }
  @media (max-width: 860px) {
    .ftr__base {
      padding-bottom: calc(2rem + 64px);
    }
  }
</style>
