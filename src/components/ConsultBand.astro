---
// DLife "Book a free consultation" block, headed with the brand book's closing line.
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import EnquiryForm from './EnquiryForm.astro';
import { site, whatsappLink } from '../data/site';
import { photos } from '../data/content';

interface Props {
  title?: string;
  text?: string;
  image?: ImageMetadata;
}
const {
  title = 'Let’s create something amazing together',
  text = 'Tell us a little about your home. We’ll call you back within one working day to set up a free consultation.',
  image = photos.greenLounge,
} = Astro.props;
---

<section class="cb" id="enquiry" aria-labelledby="cb-title">
  <div class="cb__media cover" data-reveal>
    <Picture src={image} alt="" widths={[480, 740]} sizes="(min-width: 1000px) 40vw, 100vw" formats={['avif', 'webp']} />
  </div>
  <div class="cb__body">
    <h2 id="cb-title">{title}</h2>
    <p class="lede">{text}</p>
    <EnquiryForm id="cb-form" />
    <div class="cb__direct">
      <a href={site.phoneHref}><Icon name="phone" />{site.phoneDisplay}</a>
      <a href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" />Chat on WhatsApp</a>
    </div>
  </div>
</section>

<style>
  .cb {
    display: grid;
    background: var(--cream);
  }
  @media (min-width: 1000px) {
    .cb {
      grid-template-columns: 0.8fr 1.2fr;
      min-height: 760px;
    }
  }
  .cb__media {
    min-height: 340px;
  }
  @media (min-width: 1000px) {
    .cb__media {
      min-height: 100%;
    }
  }
  .cb__media :global(picture) {
    position: absolute;
    inset: 0;
  }
  .cb__body {
    padding: var(--section) var(--gutter);
    max-width: 820px;
  }
  @media (min-width: 1000px) {
    .cb__body {
      padding-inline: clamp(3rem, 6vw, 7rem);
    }
  }
  .cb__body h2 {
    max-width: 13ch;
    margin-bottom: 1.25rem;
  }
  .cb__body .lede {
    margin-bottom: 2.5rem;
  }
  .cb__direct {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .cb__direct a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    color: var(--mocha);
    font-weight: 500;
    text-decoration: none;
  }
  .cb__direct a:hover {
    text-decoration: underline;
  }
  .cb__direct :global(svg) {
    width: 20px;
    height: 20px;
  }
</style>
