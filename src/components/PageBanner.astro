---
// DLife-style inner page banner: full-width photo, dark gradient, title bottom-left.
import { Picture } from 'astro:assets';

interface Props {
  title: string;
  intro?: string;
  image: ImageMetadata;
  crumb: string;
}
const { title, intro, image, crumb } = Astro.props;
---

<section class="pb dark">
  <div class="pb__media cover">
    <Picture
      src={image}
      alt=""
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="wrap pb__in">
    <nav aria-label="Breadcrumb" class="pb__crumb">
      <ol role="list">
        <li><a href="/">Home</a></li>
        <li aria-current="page">{crumb}</li>
      </ol>
    </nav>
    <h1>{title}</h1>
    {intro && <p class="lede">{intro}</p>}
  </div>
</section>

<style>
  .pb {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(420px, 62vh, 640px);
    overflow: hidden;
  }
  .pb__media {
    position: absolute;
    inset: 0;
  }
  .pb__media :global(picture) {
    position: absolute;
    inset: 0;
  }
  .pb__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(40, 26, 19, 0.88) 0%, rgba(40, 26, 19, 0.35) 55%, rgba(40, 26, 19, 0.15) 100%);
  }
  .pb__in {
    position: relative;
    padding-block: 3rem clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }
  .pb h1 {
    max-width: 14ch;
    font-size: var(--fs-hero);
    color: var(--cream);
  }
  .pb .lede {
    margin: 1.25rem 0 0;
    color: rgba(247, 239, 232, 0.82);
  }
  .pb__crumb ol {
    display: flex;
    gap: 0.6rem;
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
    font-size: var(--fs-xs);
    color: rgba(247, 239, 232, 0.7);
  }
  .pb__crumb li + li::before {
    content: '/';
    margin-right: 0.6rem;
    opacity: 0.5;
  }
  .pb__crumb a {
    color: inherit;
    text-decoration: none;
  }
  .pb__crumb a:hover {
    color: var(--cream);
  }
  @media (prefers-reduced-motion: no-preference) {
    .pb__media :global(img) {
      animation: pb-settle 2.2s var(--ease-out) both;
    }
  }
  @keyframes pb-settle {
    from {
      transform: scale(1.08);
    }
  }
</style>
