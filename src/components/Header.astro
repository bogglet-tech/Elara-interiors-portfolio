---
// Centred-logo header (luxury-studio layout): links split either side of the wordmark.
// Overlay mode (home): transparent over the hero; the logo flies in from the hero centre and --p (0 → 1) fades the bar in.
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site, nav, whatsappLink } from '../data/site';

interface Props {
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const left = nav.filter((n) => ['/about', '/services', '/gallery'].includes(n.href));
---

<header class:list={['hdr', { 'hdr--overlay': overlay }]} data-header>
  <div class="wrap hdr__in">
    <div class="hdr__left">
      <button class="hdr__menu" type="button" aria-expanded="false" aria-controls="menu" data-menu-open>
        <span class="hdr__bars" aria-hidden="true"><i></i><i></i></span>
        <span class="hdr__menu-label">Menu</span>
      </button>
      <nav aria-label="Main">
        <ul role="list" class="hdr__links">
          {
            left.map((n) => (
              <li>
                <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    {
      overlay ? (
        <span class="hdr__logo" data-logo-slot aria-hidden="true" />
      ) : (
        <a href="/" class="hdr__logo" aria-label="Elara Interiors home">
          <Logo />
        </a>
      )
    }

    <div class="hdr__right">
      <ul role="list" class="hdr__links">
        <li><a href="/contact" aria-current={isActive('/contact') ? 'page' : undefined}>Contact</a></li>
      </ul>
      <a class="hdr__phone" href={site.phoneHref} aria-label={`Call ${site.phoneDisplay}`}>
        <Icon name="phone" /><span>{site.phoneDisplay}</span>
      </a>
      <a class="hdr__cta" href="/contact#enquiry">Free estimate</a>
    </div>
  </div>
</header>

<div class="menu dark" id="menu" role="dialog" aria-modal="true" aria-label="Menu" data-menu hidden>
  <div class="wrap menu__top">
    <button type="button" class="menu__close" data-menu-close>
      <Icon name="close" /><span>Close</span>
    </button>
    <Logo class="menu__logo" label="Elara Interiors" />
    <span class="menu__spacer"></span>
  </div>
  <nav class="wrap menu__nav" aria-label="Mobile">
    <ol role="list">
      {
        nav.map((n) => (
          <li>
            <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>
              {n.label}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
  <div class="wrap menu__foot">
    <a class="btn btn--sand" href="/contact#enquiry">Get a free estimate</a>
    <a class="btn btn--ghost-light" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" />WhatsApp</a>
    <a class="menu__line" href={site.phoneHref}>{site.phoneDisplay}</a>
    <a class="menu__line" href={`mailto:${site.email}`}>{site.email}</a>
  </div>
</div>

<style>
  .hdr {
    --ink: var(--espresso);
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--cream);
    box-shadow: 0 1px 0 var(--line);
  }
  .hdr__in {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    height: var(--header-h);
  }
  .hdr__left,
  .hdr__right {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.2vw, 2.25rem);
  }
  .hdr__right {
    justify-content: flex-end;
  }
  .hdr__logo {
    display: block;
    width: clamp(120px, 6vw + 60px, 156px);
    aspect-ratio: 2979 / 816;
  }

  .hdr__links {
    display: flex;
    gap: clamp(1.25rem, 2.2vw, 2.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hdr__links a,
  .hdr__phone,
  .hdr__menu {
    position: relative;
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: color 0.3s var(--ease);
  }
  .hdr__links a {
    display: inline-block;
    padding-block: 0.6rem;
  }
  .hdr__links a::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.1rem;
    width: 4px;
    height: 4px;
    background: var(--sand);
    transform: translateX(-50%) rotate(45deg) scale(0);
    transition: transform 0.3s var(--ease);
  }
  .hdr__links a:hover::after,
  .hdr__links a[aria-current='page']::after {
    transform: translateX(-50%) rotate(45deg) scale(1);
  }

  .hdr__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hdr__phone :global(svg) {
    width: 16px;
    height: 16px;
  }
  .hdr__cta {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 1.2rem;
    border: 1px solid color-mix(in srgb, var(--ink) 45%, transparent);
    border-radius: 999px;
    color: var(--ink);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }
  .hdr__cta:hover {
    background: var(--mocha);
    border-color: var(--mocha);
    color: var(--cream);
  }

  /* Menu toggle: hidden on wide screens where the links fit */
  .hdr__menu {
    display: none;
    align-items: center;
    gap: 0.7rem;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .hdr__bars {
    display: grid;
    gap: 6px;
    width: 22px;
  }
  .hdr__bars i {
    display: block;
    height: 1.5px;
    background: currentColor;
  }
  .hdr__bars i:last-child {
    width: 14px;
  }

  @media (max-width: 1240px) {
    .hdr__phone span {
      display: none;
    }
  }
  @media (max-width: 1060px) {
    .hdr__left nav,
    .hdr__right .hdr__links,
    .hdr__cta {
      display: none;
    }
    .hdr__menu {
      display: inline-flex;
    }
    .hdr__phone {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      margin-right: -10px;
    }
    .hdr__phone :global(svg) {
      width: 20px;
      height: 20px;
    }
  }
  @media (max-width: 420px) {
    .hdr__menu-label {
      display: none;
    }
  }

  /* Overlay mode (home): stays transparent over the whole pinned hero; --h (0 → 1) turns it cream
     only as the hero scrolls away and the next section arrives. */
  .hdr--overlay {
    --ink: color-mix(in srgb, var(--espresso) calc(var(--h, 0) * 100%), var(--cream));
    position: fixed;
    inset: 0 0 auto;
    background: rgb(247 239 232 / var(--h, 0));
    box-shadow: 0 1px 0 rgb(103 66 48 / calc(var(--h, 0) * 0.16));
  }
  .hdr--overlay .hdr__cta:hover {
    background: var(--sand);
    border-color: var(--sand);
    color: var(--espresso);
  }

  /* Full-screen menu */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    padding-bottom: 2rem;
  }
  .menu[hidden] {
    display: none;
  }
  .menu__top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 72px;
  }
  .menu__top :global(.menu__logo) {
    width: 120px;
    --logo-main: var(--cream);
  }
  .menu__close {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    justify-self: start;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--cream);
    font: 400 0.875rem / 1 var(--font-body);
    letter-spacing: 0.06em;
    cursor: pointer;
  }
  .menu__close :global(svg) {
    width: 22px;
    height: 22px;
  }
  .menu__nav {
    flex: 1;
    padding-block: 2rem;
  }
  .menu__nav ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .menu__nav li {
    border-bottom: 1px solid var(--line-dark);
  }
  .menu__nav a {
    display: block;
    padding-block: 0.9rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 8vw, 3rem);
    line-height: 1.1;
    color: var(--cream);
    text-decoration: none;
  }
  .menu__nav a[aria-current='page'] {
    color: var(--sand);
  }
  .menu__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .menu__line {
    flex-basis: 100%;
    color: rgb(247 239 232 / 0.75);
    text-decoration: none;
  }
  .menu__line:first-of-type {
    margin-top: 1rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .menu:not([hidden]) {
      animation: menu-in 0.45s var(--ease-out);
    }
    .menu:not([hidden]) .menu__nav li {
      animation: menu-item 0.6s var(--ease-out) both;
    }
    .menu__nav li:nth-child(2) {
      animation-delay: 0.04s !important;
    }
    .menu__nav li:nth-child(3) {
      animation-delay: 0.08s !important;
    }
    .menu__nav li:nth-child(4) {
      animation-delay: 0.12s !important;
    }
    .menu__nav li:nth-child(5) {
      animation-delay: 0.16s !important;
    }
  }
  @keyframes menu-in {
    from {
      opacity: 0;
    }
  }
  @keyframes menu-item {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]')!;
  const closeBtn = menu.querySelector<HTMLButtonElement>('[data-menu-close]')!;

  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    openBtn.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    (open ? closeBtn : openBtn).focus();
  };
  openBtn.addEventListener('click', () => setOpen(true));
  closeBtn.addEventListener('click', () => setOpen(false));
  menu.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
    if (e.key === 'Tab') {
      const f = [...menu.querySelectorAll<HTMLElement>('a, button')];
      const first = f[0];
      const last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
  matchMedia('(min-width: 1061px)').addEventListener('change', (e) => e.matches && !menu.hidden && setOpen(false));

  const onScroll = () => header.toggleAttribute('data-scrolled', scrollY > 10);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
