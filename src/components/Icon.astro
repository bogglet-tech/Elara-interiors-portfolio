---
interface Props {
  name: 'phone' | 'whatsapp' | 'mail' | 'pin' | 'clock' | 'menu' | 'close' | 'instagram' | 'facebook' | 'youtube' | 'chevron' | 'prev' | 'next' | 'team' | 'ruler' | 'gem' | 'support' | 'plus';
  class?: string;
}
const { name, class: cls } = Astro.props;
---

<svg class={cls} width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
  {name === 'phone' && <path d="M5 3.5h3.2l1.6 4-2.1 1.3a11 11 0 0 0 7.5 7.5l1.3-2.1 4 1.6V19a1.6 1.6 0 0 1-1.7 1.6A16.6 16.6 0 0 1 3.4 5.2 1.6 1.6 0 0 1 5 3.5Z" />}
  {name === 'whatsapp' && (
    <>
      <path d="M3.6 20.4 4.9 16A8.6 8.6 0 1 1 8 19.2Z" />
      <path d="M9 8.3c.2-.5.5-.6.8-.6h.5c.2 0 .4 0 .5.4l.7 1.6c.1.2 0 .4-.1.6l-.5.6c-.1.1-.2.3 0 .5a6 6 0 0 0 2.9 2.5c.2.1.4.1.5-.1l.6-.8c.2-.2.4-.2.6-.1l1.6.8c.2.1.4.2.4.4 0 .5-.2 1.3-.8 1.6-.6.4-1.6.6-3.6-.3a9.6 9.6 0 0 1-3.6-3.4c-.6-1-.9-2.4-.5-3.7Z" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'mail' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="1.5" />
      <path d="m3.5 6 8.5 7 8.5-7" />
    </>
  )}
  {name === 'pin' && (
    <>
      <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z" />
      <circle cx="12" cy="9.5" r="2.5" />
    </>
  )}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <path d="M12 7.5V12l3 2" />
    </>
  )}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'team' && (
    <>
      <circle cx="9" cy="8" r="3" />
      <path d="M3.5 19a5.5 5.5 0 0 1 11 0" />
      <circle cx="17" cy="9" r="2.3" />
      <path d="M16 13.6a4.5 4.5 0 0 1 5 4.4" />
    </>
  )}
  {name === 'ruler' && (
    <>
      <path d="m3 16.5 13.5-13.5 4.5 4.5L7.5 21Z" />
      <path d="m7 12.5 2 2M10 9.5l1.5 1.5M13 6.5l2 2" />
    </>
  )}
  {name === 'gem' && (
    <>
      <path d="M12 3.5 20.5 12 12 20.5 3.5 12Z" />
      <path d="M12 8 16 12 12 16 8 12Z" />
    </>
  )}
  {name === 'support' && (
    <>
      <path d="M4 13v-1a8 8 0 0 1 16 0v1" />
      <rect x="3" y="13" width="4" height="6" rx="1.5" />
      <rect x="17" y="13" width="4" height="6" rx="1.5" />
      <path d="M19 19c0 1.5-2 2.5-5 2.5" />
    </>
  )}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'chevron' && <path d="m6 9 6 6 6-6" />}
  {name === 'prev' && <path d="m15 5-7 7 7 7" />}
  {name === 'next' && <path d="m9 5 7 7-7 7" />}
  {name === 'instagram' && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'facebook' && <path d="M14 8.5h2.5V5H14a3.5 3.5 0 0 0-3.5 3.5V11H8v3.5h2.5V21H14v-6.5h2.5L17 11h-3V9a.5.5 0 0 1 .5-.5Z" />}
  {name === 'youtube' && (
    <>
      <rect x="2.5" y="5.5" width="19" height="13" rx="3.5" />
      <path d="m10 9.2 5 2.8-5 2.8Z" fill="currentColor" stroke="none" />
    </>
  )}
</svg>
