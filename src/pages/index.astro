---
import { Picture, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import Packages from '../components/Packages.astro';
import Process from '../components/Process.astro';
import ConsultBand from '../components/ConsultBand.astro';
import logoWhite from '../assets/brand/logo-white.png';
import { site, whatsappLink } from '../data/site';
import { photos, categories, promises, gallery } from '../data/content';

const slides = [
  { image: photos.heroTeakBedroom, caption: 'Teak-panelled master bedroom', alt: 'Bedroom with teak wall panelling, warm cove lighting and a dark wooden bed' },
  { image: photos.bedroomSlats, caption: 'Bedroom with wooden wall slats', alt: 'Bedroom with dark wooden wall slats and warm bedside lighting' },
  { image: photos.bedroomSunlit, caption: 'Sunlit guest bedroom', alt: 'Bedroom with wooden floor, low bed and evening sun through tall windows' },
  { image: photos.goldenLiving, caption: 'Double-height living room', alt: 'Double-height living room with marble floor, cream sectional sofa and golden cove lighting' },
  { image: photos.livingDark, caption: 'Living room with a dark feature wall', alt: 'Living room with a dark feature wall, low sofa and framed art' },
];
const rail = [gallery[2], gallery[5], gallery[8], gallery[6], gallery[10], gallery[12]];
---

<Base
  overlayHeader
  title={site.name}
  description="Elara Interiors designs complete home interiors for apartments, villas and independent homes: modular kitchens, bedrooms, wardrobes, living and dining spaces. Complete 2 BHK interiors for ₹5,00,000."
>
  <!-- 1. Hero: full-bleed photo, the logo centred; on scroll it flies into the navbar -->
  <!-- Lives outside the sticky hero: a sticky element is its own stacking context, which would trap the logo under the navbar -->
  <a href="/" class="fly" data-fly aria-label="Elara Interiors home"><Logo /></a>

  <div class="hero-wrap" data-hero-wrap>
  <section class="hero dark" aria-labelledby="hero-title" data-hero data-slider>
    <div class="hero__slides" aria-roledescription="carousel" aria-label="Featured rooms">
      {
        slides.map((s, i) => (
          <figure class="hero__slide cover" data-slide aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}: ${s.caption}`} data-active={i === 0 ? '' : undefined}>
            <Picture
              src={s.image}
              alt={s.alt}
              widths={[640, 1024, 1440, 2000]}
              sizes="100vw"
              formats={['avif', 'webp']}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
            />
          </figure>
        ))
      }
    </div>

    <p class="hero__cue" aria-hidden="true"><span>Scroll</span><i></i></p>

    <div class="wrap hero__content">
      <div class="hero__text">
        <h1 id="hero-title">Designed for the way you live</h1>
        <p class="hero__lede">
          Complete interiors for apartments, villas and independent homes. Planned room by room, made to measure and
          installed by one team.
        </p>
        <div class="actions">
          <a class="btn btn--sand" href="/contact#enquiry">Get a free estimate</a>
          <a class="btn btn--ghost-light" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" />Chat on WhatsApp</a>
        </div>
      </div>

      <div class="hero__side">
        <a class="hero__offer" href="#packages">
          <span>Complete 2 BHK interiors</span>
          <strong>₹5,00,000</strong>
          <span class="hero__offer-link">See packages</span>
        </a>
        <div class="hero__ctrl">
          <button type="button" class="hero__pause" data-pause aria-label="Pause slideshow" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path class="i-pause" d="M8 5v14M16 5v14" /><path class="i-play" d="M8 5l11 7-11 7Z" /></svg>
          </button>
          {slides.map((sl, i) => (
            <button type="button" class="hero__dot" data-dot={i} aria-label={`Show photo ${i + 1}: ${sl.caption}`} aria-current={i === 0 ? 'true' : undefined}>
              <span />
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>
  </div>

  <noscript>
    <style>
      /* without JavaScript the logo simply sits in the navbar slot */
      .fly { opacity: 1 !important; top: calc((var(--header-h) - 42px) / 2) !important; left: 50% !important; transform: translateX(-50%) !important; }
    </style>
  </noscript>
  <!-- Place the flying logo synchronously, before the first paint (the bundled script below runs later).
       Keep the numbers in step with update() in the module script: 0.4, 0.78/0.5, 760, 0.46. -->
  <script is:inline>
    (function () {
      var f = document.querySelector('[data-fly]'),
        s = document.querySelector('[data-logo-slot]'),
        h = document.querySelector('[data-hero]'),
        w = document.querySelector('[data-hero-wrap]');
      if (!f || !s || !h || !w) return;
      var r = s.getBoundingClientRect(),
        vw = document.documentElement.clientWidth,
        vh = h.offsetHeight,
        y = window.scrollY - w.offsetTop,
        t = Math.min(1, Math.max(0, y / (vh * 0.4))),
        e = 1 - Math.pow(1 - t, 3),
        big = Math.min(vw * (vw < 700 ? 0.78 : 0.5), 760),
        W = big + (r.width - big) * e,
        H = W * (r.height / r.width),
        cx = vw / 2 + (r.left + r.width / 2 - vw / 2) * e,
        cy = vh * 0.46 + (r.top + r.height / 2 - vh * 0.46) * e;
      f.style.width = W.toFixed(1) + 'px';
      f.style.transform = 'translate3d(' + (cx - W / 2).toFixed(1) + 'px,' + (cy - H / 2).toFixed(1) + 'px,0)';
      document.documentElement.style.setProperty('--p', e.toFixed(3));
      f.setAttribute('data-ready', '');
    })();
  </script>

  <!-- 2. Stat strip: icon, value, caption -->
  <section class="promise" aria-label="Elara at a glance">
    <div class="wrap">
      <ul class="promise__list" role="list">
        {
          promises.map((p) => (
            <li class="promise__item">
              <Icon name={p.icon as 'clock'} class="promise__icon" />
              <strong class="promise__value">{p.value}</strong>
              <span class="promise__label">{p.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3. Package offers -->
  <Packages tone="white" />

  <!-- 4. Introduction: brand book "Brand Introduction" slide -->
  <section class="section intro" aria-labelledby="intro-title">
    <div class="wrap intro__grid">
      <div class="intro__art">
        <div class="intro__photo cover" data-reveal>
          <Picture
            src={photos.greenLounge}
            alt="Lounge with a green velvet sofa, wooden wall slats and a low wooden table"
            widths={[400, 736]}
            sizes="(min-width: 900px) 34vw, 80vw"
            formats={['avif', 'webp']}
          />
        </div>
        <div class="intro__mark" aria-hidden="true">
          <Image src={logoWhite} alt="" width={220} densities={[1, 2]} />
        </div>
      </div>
      <div class="intro__copy">
        <h2 id="intro-title">Homes that feel uniquely yours</h2>
        <p class="lede">
          Elara Interiors is a contemporary interior design company. We turn houses into personal homes that reflect each
          family’s lifestyle, preferences and plans for the future.
        </p>
        <p>
          Great interiors go beyond how a room looks. They should be comfortable, practical and give you a lasting sense of
          belonging. So every project starts with careful planning, uses quality materials, and is coordinated by our team
          from the first concept to the final handover.
        </p>
        <a class="link" href="/about">Our story</a>
      </div>
    </div>
  </section>

  <!-- 5. What we design: hover rows that swap a preview photo -->
  <section class="section white wd" aria-labelledby="wd-title">
    <div class="wrap">
      <div class="head">
        <h2 id="wd-title">What we design</h2>
        <div class="head__aside">
          <p>Take on the whole home, or start with the one room that needs it most.</p>
          <a class="link" href="/services">All services</a>
        </div>
      </div>

      <div class="wd__grid" data-wd>
        <ul class="wd__list" role="list">
          {
            categories.map((c, i) => (
              <li>
                <a href={`/services#${c.id}`} class="wd__row" data-wd-row={i} aria-current={i === 0 ? 'true' : undefined}>
                  <span class="wd__thumb cover">
                    <Picture src={c.image} alt="" widths={[160, 320]} sizes="96px" formats={['avif', 'webp']} />
                  </span>
                  <span class="wd__text">
                    <span class="wd__name">{c.name}</span>
                    <span class="wd__desc"><span>{c.text}</span></span>
                  </span>
                  <Icon name="next" class="wd__go" />
                </a>
              </li>
            ))
          }
        </ul>
        <div class="wd__preview" aria-hidden="true">
          {
            categories.map((c, i) => (
              <div class="wd__img cover" data-wd-img={i} data-active={i === 0 ? '' : undefined}>
                <Picture src={c.image} alt="" widths={[560, 900]} sizes="38vw" formats={['avif', 'webp']} />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Process -->
  <Process />

  <!-- 7. Made to measure (DLife's "factory" section, told honestly) -->
  <section class="mm" aria-labelledby="mm-title">
    <div class="mm__media cover">
      <Picture
        src={photos.bedroomSunlit}
        alt="Bedroom with wooden floor, low bed and evening sun through tall windows"
        widths={[800, 1300, 2000]}
        sizes="100vw"
        formats={['avif', 'webp']}
      />
    </div>
    <div class="wrap mm__in">
      <div class="mm__card">
        <h2 id="mm-title">Made to measure, down to the last drawer</h2>
        <p>
          Cabinets, wardrobes and furniture are produced to your room’s exact measurements, in the boards, hardware and
          finishes you approve. Then our team installs everything and stays on call after you move in.
        </p>
        <a class="link" href="/services">How we work</a>
      </div>
    </div>
  </section>

  <!-- 8. Rooms showcase: one room in focus, the rest as narrow panels; auto-advances -->
  <section class="section work" aria-labelledby="work-title" data-rooms>
    <div class="wrap">
      <div class="head">
        <h2 id="work-title">Rooms we’ve put together</h2>
        <div class="head__aside">
          <p>Kitchens, bedrooms and living spaces in warm, lasting materials.</p>
          <div class="work__nav">
            <a class="link" href="/gallery">Open the gallery</a>
            <button type="button" class="work__btn" data-rm-prev aria-label="Previous room"><Icon name="prev" /></button>
            <button type="button" class="work__btn work__btn--next" data-rm-next aria-label="Next room">
              <svg class="work__ring" viewBox="0 0 50 50" aria-hidden="true"><circle cx="25" cy="25" r="23.5" /></svg>
              <Icon name="next" />
            </button>
          </div>
        </div>
      </div>

      <ul class="rm" role="list" aria-roledescription="carousel" aria-label="Rooms">
        {
          rail.map((g, i) => (
            <li class="rm__item" data-rm-item data-active={i === 0 ? '' : undefined} style={`--h: ${['100%', '64%', '84%', '50%', '74%', '58%'][i % 6]}`}>
              <div class="rm__media cover">
                <Picture src={g.image} alt={g.alt} widths={[400, 700, 1000]} sizes="(min-width: 900px) 50vw, 70vw" formats={['avif', 'webp']} />
              </div>
              <span class="rm__tag" aria-hidden="true">{g.room}</span>
              <div class="rm__cap">
                <span class="rm__room">{g.room}</span>
                <h3>{g.caption}</h3>
                <a class="rm__link" href="/gallery">Open in gallery</a>
              </div>
              <button type="button" class="rm__hit" data-rm-hit aria-label={`Show ${g.caption}`} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 9. Consultation -->
  <ConsultBand />
</Base>

<style>
  /* ================= Hero =================
     Pinned for one extra screen of scrolling, in three beats driven by JS:
     1) only the photo + centred logo, 2) logo rises into the navbar (--p), 3) the copy appears (--c). */
  .hero-wrap {
    position: relative;
    height: 210svh;
  }
  .hero {
    position: sticky;
    top: 0;
    display: flex;
    align-items: flex-end;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: var(--espresso);
  }
  :global(.js) .hero__content {
    opacity: var(--c, 0);
    transform: translateY(calc((1 - var(--c, 0)) * 32px));
    visibility: var(--c-vis, hidden);
  }
  .hero__cue {
    position: absolute;
    left: 50%;
    bottom: 2rem;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    margin: 0;
    transform: translateX(-50%);
    color: rgb(247 239 232 / 0.8);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    opacity: calc(1 - var(--p, 0) * 2.5);
  }
  .hero__cue i {
    position: relative;
    width: 1px;
    height: 44px;
    overflow: hidden;
    background: rgb(247 239 232 / 0.25);
  }
  .hero__cue i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--cream);
    transform: translateY(-100%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__cue i::after {
      animation: cue 2s var(--ease) infinite;
    }
  }
  @keyframes cue {
    60%,
    100% {
      transform: translateY(100%);
    }
  }
  :global(html:not(.js)) .hero__cue {
    display: none;
  }
  .hero__slides,
  .hero__slide {
    position: absolute;
    inset: 0;
  }
  .hero__slide {
    margin: 0;
    opacity: 0;
    transition: opacity 1.6s var(--ease);
  }
  .hero__slide[data-active] {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__slide[data-active] :global(img) {
      animation: kenburns 8s linear both;
    }
  }
  @keyframes kenburns {
    from {
      transform: scale(1.1);
    }
    to {
      transform: scale(1);
    }
  }
  /* darken top (navbar legibility) and bottom (copy legibility) */
  .hero__slides::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(30 19 13 / 0.5) 0%, rgb(30 19 13 / 0) 22%),
      rgb(30 19 13 / 0.22);
  }
  .hero__slides::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to top, rgb(30 19 13 / 0.9) 0%, rgb(30 19 13 / 0.5) 40%, rgb(30 19 13 / 0.1) 70%);
    opacity: var(--c, 1);
  }
  .hero__slides::after {
    z-index: 1;
  }

  /* The flying logo. JS sets left/top/width to the navbar slot and drives transform + --p. */
  .fly {
    --logo-main: color-mix(in srgb, var(--mocha) calc(var(--h, 0) * 100%), var(--white));
    position: fixed;
    z-index: 60;
    top: 0;
    left: 0;
    width: clamp(120px, 6vw + 60px, 156px);
    transform-origin: 0 0;
    /* hidden until it has been placed (inline script right after the hero), so it can never flash in a corner */
    opacity: 0;
  }
  .fly[data-ready] {
    opacity: 1;
    transition: opacity 0.6s var(--ease);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2rem;
    padding-bottom: clamp(2rem, 1rem + 3vw, 3.5rem);
  }
  @media (min-width: 861px) {
    .hero__content {
      padding-bottom: calc(clamp(1rem, 2vw, 2rem) + 54px + 1.5rem); /* clear the floating estimate button */
    }
  }
  @media (min-width: 1000px) {
    .hero__content {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }
  .hero h1 {
    max-width: 12ch;
    margin-bottom: 1rem;
    font-size: clamp(2.4rem, 1.3rem + 3.6vw, 4.75rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--cream);
  }
  .hero__lede {
    max-width: 44ch;
    margin-bottom: 1.75rem;
    font-size: var(--fs-md);
    font-weight: 300;
    line-height: 1.55;
    color: rgb(247 239 232 / 0.85);
  }
  @media (max-width: 640px) {
    .hero__lede {
      font-size: var(--fs-base);
    }
  }
  .hero__side {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  @media (min-width: 1000px) {
    .hero__side {
      justify-items: end;
      text-align: right;
    }
  }
  .hero__offer {
    display: grid;
    gap: 0.15rem;
    color: var(--cream);
    text-decoration: none;
  }
  .hero__offer span:first-child {
    font-size: var(--fs-sm);
    color: rgb(247 239 232 / 0.75);
  }
  .hero__offer strong {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 400;
    line-height: 1.1;
    color: var(--sand);
  }
  .hero__offer-link {
    justify-self: inherit;
    font-size: var(--fs-sm);
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-color: var(--sand);
  }
  @media (max-width: 999px) {
    .hero__offer {
      display: none;
    }
  }
  .hero__ctrl {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .hero__dot {
    width: 44px;
    height: 32px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .hero__dot span {
    display: block;
    height: 2px;
    background: rgb(247 239 232 / 0.35);
    overflow: hidden;
  }
  .hero__dot span::after {
    content: '';
    display: block;
    height: 100%;
    background: var(--cream);
    transform: scaleX(0);
    transform-origin: left;
  }
  .hero__dot[aria-current='true'] span::after {
    transform: scaleX(1);
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-playing] .hero__dot[aria-current='true'] span::after {
      animation: progress 6s linear both;
    }
  }
  @keyframes progress {
    from {
      transform: scaleX(0);
    }
  }
  .hero__pause {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    margin-right: 0.5rem;
    border: 1px solid rgb(247 239 232 / 0.4);
    border-radius: 50%;
    background: none;
    color: var(--cream);
    cursor: pointer;
  }
  .hero__pause svg {
    width: 14px;
    height: 14px;
  }
  .i-pause {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }
  .i-play {
    display: none;
    fill: currentColor;
  }
  .hero__pause[aria-pressed='true'] .i-pause {
    display: none;
  }
  .hero__pause[aria-pressed='true'] .i-play {
    display: inline;
  }

  /* Stat strip */
  .promise {
    padding-block: clamp(2.5rem, 2rem + 2vw, 3.75rem);
    background: var(--white);
  }
  .promise .wrap {
    position: relative;
  }
  .promise .wrap::after {
    content: '';
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: calc(-1 * clamp(2.5rem, 2rem + 2vw, 3.75rem));
    height: 1px;
    background: var(--line);
  }
  .promise__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 900px) {
    .promise__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .promise__item {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    text-align: center;
  }
  .promise__item :global(.promise__icon) {
    width: 22px;
    height: 22px;
    margin-bottom: 0.9rem;
    color: var(--sand);
    stroke-width: 1.2;
  }
  .promise__value {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.5rem + 1.8vw, 3rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--mocha);
  }
  .promise__label {
    margin-top: 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ================= Intro ================= */
  .intro__grid {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 7rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .intro__grid {
      grid-template-columns: 0.9fr 1.1fr;
    }
  }
  .intro__art {
    position: relative;
    padding-right: clamp(3rem, 8vw, 7rem);
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .intro__photo {
    aspect-ratio: 3 / 4;
  }
  .intro__mark {
    position: absolute;
    right: 0;
    bottom: 0;
    display: grid;
    place-items: center;
    width: clamp(150px, 46%, 280px);
    aspect-ratio: 0.82;
    padding: 1.5rem;
    background: var(--sand);
  }
  .intro__mark :global(img) {
    width: 80%;
    height: auto;
  }
  .intro__copy h2 {
    max-width: 11ch;
    margin-bottom: 1.75rem;
  }
  .intro__copy .lede {
    color: var(--mocha);
  }
  .intro__copy > p:not(.lede) {
    font-weight: 300;
    color: var(--muted);
    margin-bottom: 2rem;
  }

  /* ================= What we design ================= */
  .wd__grid {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 1000px) {
    .wd__grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: clamp(3rem, 6vw, 6rem);
    }
  }
  .wd__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .wd__row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.25rem;
    align-items: center;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
  }
  .wd__thumb {
    width: 76px;
    aspect-ratio: 1;
  }
  .wd__thumb :global(picture) {
    position: absolute;
    inset: 0;
  }
  @media (min-width: 1000px) {
    .wd__thumb {
      display: none;
    }
    .wd__row {
      grid-template-columns: 1fr auto;
      padding: 1.75rem 0;
    }
  }
  .wd__name {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.6rem);
    line-height: 1.1;
    color: var(--mocha);
    transition:
      color 0.3s var(--ease),
      transform 0.4s var(--ease);
  }
  .wd__desc {
    display: block;
    margin-top: 0.4rem;
    max-width: 52ch;
    font-size: var(--fs-sm);
    font-weight: 300;
    color: var(--muted);
  }
  @media (min-width: 1000px) {
    .wd__desc {
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
      margin-top: 0;
      transition:
        grid-template-rows 0.45s var(--ease),
        opacity 0.45s var(--ease),
        margin-top 0.45s var(--ease);
    }
    .wd__desc > span {
      overflow: hidden;
    }
    .wd__row[aria-current='true'] .wd__desc {
      grid-template-rows: 1fr;
      opacity: 1;
      margin-top: 0.6rem;
    }
    .wd__row:not([aria-current='true']) .wd__name {
      color: rgba(103, 66, 48, 0.5);
    }
    .wd__row[aria-current='true'] .wd__name {
      transform: translateX(0.5rem);
    }
  }
  .wd__row :global(.wd__go) {
    width: 24px;
    height: 24px;
    color: var(--sand);
    transition: transform 0.3s var(--ease);
  }
  .wd__row:hover :global(.wd__go) {
    transform: translateX(4px);
  }
  .wd__preview {
    display: none;
  }
  @media (min-width: 1000px) {
    .wd__preview {
      display: block;
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      aspect-ratio: 4 / 5;
      align-self: start;
    }
  }
  .wd__img {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.6s var(--ease);
  }
  .wd__img[data-active] {
    opacity: 1;
  }
  .wd__img :global(picture) {
    position: absolute;
    inset: 0;
  }

  /* ================= Made to measure ================= */
  .mm {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(560px, 92vh, 860px);
  }
  .mm__media {
    position: absolute;
    inset: 0;
  }
  .mm__media :global(picture) {
    position: absolute;
    inset: 0;
  }
  .mm__in {
    position: relative;
    padding-block: var(--gutter);
  }
  .mm__card {
    max-width: 560px;
    padding: clamp(2rem, 1.5rem + 2.5vw, 3.75rem);
    background: var(--cream);
  }
  .mm__card h2 {
    margin-bottom: 1.25rem;
    font-size: var(--fs-xl);
  }
  .mm__card p {
    font-weight: 300;
    color: var(--muted);
    margin-bottom: 1.75rem;
  }

  /* ================= Rooms showcase ================= */
  .work__nav {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .work__nav .link {
    margin-right: 1rem;
  }
  .work__btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: none;
    color: var(--mocha);
    cursor: pointer;
    transition: background-color 0.2s var(--ease);
  }
  .work__btn:hover {
    background: var(--mocha);
    color: var(--cream);
  }
  .work__btn :global(svg:not(.work__ring)) {
    width: 20px;
    height: 20px;
  }
  /* countdown ring on the next button */
  .work__ring {
    position: absolute;
    inset: -1px;
    width: calc(100% + 2px);
    height: calc(100% + 2px);
    transform: rotate(-90deg);
    pointer-events: none;
  }
  .work__ring circle {
    fill: none;
    stroke: var(--mocha);
    stroke-width: 1.5;
    stroke-dasharray: 148;
    stroke-dashoffset: 148;
  }
  [data-rm-playing] .work__ring circle {
    animation: rm-ring var(--rm-dur, 5s) linear both;
  }
  @keyframes rm-ring {
    to {
      stroke-dashoffset: 0;
    }
  }

  .rm {
    display: flex;
    align-items: flex-end;
    gap: clamp(0.5rem, 1vw, 0.9rem);
    height: clamp(420px, 30vw + 140px, 580px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rm__item {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    height: var(--h);
    overflow: hidden;
    transition:
      flex-grow 0.9s var(--ease-out),
      height 0.9s var(--ease-out);
  }
  .rm__item[data-active] {
    flex-grow: 6;
    height: 100%;
  }

  .rm__media {
    position: absolute;
    inset: 0;
  }
  .rm__media :global(img) {
    transition: transform 1.2s var(--ease-out);
  }
  .rm__item[data-active] .rm__media :global(img) {
    transform: scale(1.03);
  }
  /* inactive panels: dimmed; active: gradient under the caption */
  .rm__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(40 26 19 / 0.5);
    transition: background-color 0.6s var(--ease);
  }
  .rm__item[data-active] .rm__media::after {
    background: linear-gradient(to top, rgb(30 19 13 / 0.8) 0%, rgb(30 19 13 / 0) 45%);
  }
  .rm__item:not([data-active]):hover .rm__media::after {
    background: rgb(40 26 19 / 0.3);
  }

  .rm__tag {
    position: absolute;
    left: 50%;
    top: 1.25rem;
    color: var(--cream);
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    writing-mode: vertical-rl;
    transform: translateX(-50%) rotate(180deg);
    transform-origin: center;
    transition: opacity 0.4s var(--ease);
  }
  .rm__item[data-active] .rm__tag {
    opacity: 0;
  }
  .rm__cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    color: var(--cream);
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.3s var(--ease),
      transform 0.3s var(--ease);
    pointer-events: none;
  }
  .rm__item[data-active] .rm__cap {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.6s 0.45s var(--ease),
      transform 0.6s 0.45s var(--ease);
    pointer-events: auto;
  }
  .rm__room {
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sand);
  }
  .rm__cap h3 {
    margin: 0.4rem 0 0.9rem;
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.4rem);
    color: var(--cream);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .rm__link {
    color: var(--cream);
    font-size: var(--fs-sm);
    text-decoration: underline;
    text-decoration-color: var(--sand);
    text-underline-offset: 0.3em;
  }
  .rm__hit {
    position: absolute;
    inset: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .rm__item[data-active] .rm__hit {
    display: none;
  }
  /* Mobile: the accordion turns vertical. Active room opens tall, the rest are slim strips. All rooms show. */
  @media (max-width: 899px) {
    .rm {
      flex-direction: column;
      align-items: stretch;
      height: auto;
      gap: 0.5rem;
    }
    .rm__item {
      flex: none;
      width: 100%;
      height: 58px;
    }
    .rm__item[data-active] {
      height: clamp(340px, 95vw, 440px);
    }
    .rm__tag {
      left: 1.25rem;
      top: 50%;
      writing-mode: horizontal-tb;
      transform: translateY(-50%);
    }
    .rm__cap h3 {
      white-space: normal;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rm__item {
      transition: none;
    }
  }
</style>

<script>
  /* Flying logo: centred and large over the hero, it shrinks into the navbar slot as you scroll.
     --p (0 → 1) on :root also drives the header background and link colours. */
  const fly = document.querySelector<HTMLElement>('[data-fly]');
  const slot = document.querySelector<HTMLElement>('[data-logo-slot]');
  const heroEl = document.querySelector<HTMLElement>('[data-hero]');
  if (fly && slot && heroEl) {
    const root = document.documentElement;
    let S = { l: 0, t: 0, w: 168, h: 46 };
    let ticking = false;
    // ease-out: the logo lifts off immediately, so the scrolling headline never runs into it
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    const wrap = document.querySelector<HTMLElement>('[data-hero-wrap]')!;
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    const update = () => {
      ticking = false;
      const vw = root.clientWidth;
      const vh = heroEl.offsetHeight;
      const y = scrollY - wrap.offsetTop;
      // beat 2: logo rises over the first ~40% of a screen; beat 3: copy fades in over the next ~35%
      const e = ease(clamp(y / (vh * 0.4)));
      const c = ease(clamp((y - vh * 0.45) / (vh * 0.35)));
      const big = Math.min(vw * (vw < 700 ? 0.78 : 0.5), 760);
      // Size by width (not scale) so the SVG re-renders crisp at every size.
      const w = big + (S.w - big) * e;
      const h = w * (S.h / S.w);
      const cx = vw / 2 + (S.l + S.w / 2 - vw / 2) * e;
      const cy = vh * 0.46 + (S.t + S.h / 2 - vh * 0.46) * e;
      fly.style.width = `${w.toFixed(1)}px`;
      fly.style.transform = `translate3d(${(cx - w / 2).toFixed(1)}px, ${(cy - h / 2).toFixed(1)}px, 0)`;
      root.style.setProperty('--p', e.toFixed(3));
      root.style.setProperty('--c', c.toFixed(3));
      root.style.setProperty('--c-vis', c > 0.01 ? 'visible' : 'hidden');
      // navbar: transparent for the whole pinned hero, cream once the hero starts scrolling away
      const release = wrap.offsetHeight - vh;
      const hBar = clamp((y - release) / (vh * 0.1));
      root.style.setProperty('--h', hBar.toFixed(3));
      // while on the hero, the floating WhatsApp button becomes a Free estimate button
      const inHero = y < release + vh * 0.1;
      root.classList.toggle('in-hero', inHero);
      document.querySelector('.est')?.setAttribute('tabindex', inHero ? '0' : '-1');
      document.querySelector('.est')?.setAttribute('aria-hidden', String(!inHero));
    };
    const measure = () => {
      const r = slot.getBoundingClientRect();
      if (!r.width) return; // not laid out yet
      S = { l: r.left, t: r.top, w: r.width, h: r.height };
      update();
    };
    addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    addEventListener('resize', measure);
    // the navbar slot can shift once web fonts load or the layout settles: keep the logo locked to it
    document.fonts?.ready.then(measure);
    new ResizeObserver(measure).observe(slot);
    addEventListener('load', measure);
    measure();
    fly.setAttribute('data-ready', '');

    /* Auto-play the hero: if the visitor hasn't scrolled after a few seconds, glide down so the logo docks
       and the copy appears, then stop. Once per visit; any input cancels it; skipped for reduced motion. */
    const AUTO_DELAY = 4000;
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && scrollY < 4) {
      let cancelled = false;
      let raf = 0;
      const cancel = () => {
        cancelled = true;
        window.clearTimeout(t);
        cancelAnimationFrame(raf);
        ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach((ev) => removeEventListener(ev, cancel));
      };
      ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach((ev) => addEventListener(ev, cancel, { passive: true }));
      const t = window.setTimeout(() => {
        if (cancelled || scrollY > 4 || document.documentElement.style.overflow === 'hidden') return cancel();
        const from = scrollY;
        const to = heroEl.offsetHeight * 0.85; // copy fully visible, still inside the pinned hero
        const dur = 2200;
        const start = performance.now();
        const easeInOut = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
        const step = (now: number) => {
          if (cancelled) return;
          const k = Math.min(1, (now - start) / dur);
          window.scrollTo({ top: from + (to - from) * easeInOut(k), behavior: 'instant' });
          if (k < 1) raf = requestAnimationFrame(step);
          else cancel();
        };
        raf = requestAnimationFrame(step);
      }, AUTO_DELAY);
    }
  }

  /* Hero slider: crossfade every 6s, pausable, starts paused for reduced motion */
  const slider = document.querySelector<HTMLElement>('[data-slider]');
  if (slider) {
    const slides = [...slider.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...slider.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const pause = slider.querySelector<HTMLButtonElement>('[data-pause]')!;
    let i = 0;
    let timer: number | undefined;

    const go = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => s.toggleAttribute('data-active', k === i));
      dots.forEach((d, k) => (k === i ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
    };
    const stop = () => {
      slider.removeAttribute('data-playing');
      window.clearInterval(timer);
    };
    const play = () => {
      stop();
      void slider.offsetWidth; // restart the progress bar animation
      slider.setAttribute('data-playing', '');
      timer = window.setInterval(() => {
        go(i + 1);
        play();
      }, 6000);
    };
    const paused = () => pause.getAttribute('aria-pressed') === 'true';

    dots.forEach((d, k) =>
      d.addEventListener('click', () => {
        go(k);
        if (!paused()) play();
      }),
    );
    pause.addEventListener('click', () => {
      const p = !paused();
      pause.setAttribute('aria-pressed', String(p));
      pause.setAttribute('aria-label', p ? 'Play slideshow' : 'Pause slideshow');
      p ? stop() : play();
    });
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      pause.setAttribute('aria-pressed', 'true');
      pause.setAttribute('aria-label', 'Play slideshow');
    } else {
      play();
    }
  }

  /* What we design: hovering or focusing a row swaps the preview photo */
  const wd = document.querySelector<HTMLElement>('[data-wd]');
  if (wd) {
    const rows = [...wd.querySelectorAll<HTMLElement>('[data-wd-row]')];
    const imgs = [...wd.querySelectorAll<HTMLElement>('[data-wd-img]')];
    const set = (n: number) => {
      rows.forEach((r, k) => (k === n ? r.setAttribute('aria-current', 'true') : r.removeAttribute('aria-current')));
      imgs.forEach((im, k) => im.toggleAttribute('data-active', k === n));
    };
    rows.forEach((r, k) => {
      r.addEventListener('mouseenter', () => set(k));
      r.addEventListener('focus', () => set(k));
    });
  }

  /* Rooms showcase: one room in focus, auto-advances every 5s with a countdown ring on the next button.
     Pauses on hover / keyboard focus, when off-screen, and for reduced motion. */
  const rooms = document.querySelector<HTMLElement>('[data-rooms]');
  if (rooms) {
    const DUR = 5000;
    rooms.style.setProperty('--rm-dur', `${DUR}ms`);
    const all = [...rooms.querySelectorAll<HTMLElement>('[data-rm-item]')];
    const visible = () => all.filter((el) => el.offsetParent !== null);
    let timer: number | undefined;
    let hovering = false;
    let focused = false;
    let inView = false;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const current = () => Math.max(0, visible().findIndex((el) => el.hasAttribute('data-active')));
    const go = (n: number) => {
      const v = visible();
      const idx = (n + v.length) % v.length;
      all.forEach((el) => el.toggleAttribute('data-active', el === v[idx]));
      restart();
    };
    const stop = () => {
      window.clearTimeout(timer);
      rooms.removeAttribute('data-rm-playing');
    };
    const restart = () => {
      stop();
      if (reduce || hovering || focused || !inView) return;
      void rooms.offsetWidth; // restart the ring animation
      rooms.setAttribute('data-rm-playing', '');
      timer = window.setTimeout(() => go(current() + 1), DUR);
    };

    rooms.querySelector('[data-rm-next]')?.addEventListener('click', () => go(current() + 1));
    rooms.querySelector('[data-rm-prev]')?.addEventListener('click', () => go(current() - 1));
    all.forEach((el) =>
      el.querySelector('[data-rm-hit]')?.addEventListener('click', () => {
        go(visible().indexOf(el));
        // the click target disappears once the panel is active: keep focus inside on its link
        el.querySelector<HTMLElement>('.rm__link')?.focus({ preventScroll: true });
      }),
    );

    const list = rooms.querySelector('.rm')!;
    list.addEventListener('mouseenter', () => { hovering = true; stop(); });
    list.addEventListener('mouseleave', () => { hovering = false; restart(); });
    list.addEventListener('focusin', () => { focused = true; stop(); });
    list.addEventListener('focusout', (e) => {
      if (list.contains((e as FocusEvent).relatedTarget as Node)) return;
      focused = false;
      restart();
    });
    new IntersectionObserver(([e]) => { inView = e.isIntersecting; restart(); }, { threshold: 0.35 }).observe(list);
    // if the active item gets hidden by a breakpoint change, fall back to the first visible one
    addEventListener('resize', () => { if (!visible().some((el) => el.hasAttribute('data-active'))) go(0); });
  }
</script>
