---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import Process from '../components/Process.astro';
import Packages from '../components/Packages.astro';
import ConsultBand from '../components/ConsultBand.astro';
import Icon from '../components/Icon.astro';
import { photos, categories, faqs } from '../data/content';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base
  title="Interior design services"
  description="Modular kitchens, bedrooms, wardrobes, living and dining interiors and bespoke furniture, plus complete 2 BHK (₹5,00,000) and 4 BHK (₹7,50,000) home packages from Elara Interiors."
  ogImage={photos.kitchenGreen}
  schema={[faqSchema]}
>
  <PageBanner
    crumb="Services"
    title="Everything your home needs, from one team"
    intro="Consultation, design, production, installation and after-sales service, for one room or the whole home."
    image={photos.diningPendant}
  />

  <section class="section" aria-labelledby="svc-title">
    <div class="wrap">
      <div class="head">
        <h2 id="svc-title">What we design</h2>
        <div class="head__aside">
          <p>Every piece is made to your room’s measurements, in the finishes you choose.</p>
        </div>
      </div>

      <div class="svc">
        {
          categories.map((c, i) => (
            <article class:list={['svc__item', { 'svc__item--flip': i % 2 === 1 }]} id={c.id} aria-labelledby={`${c.id}-t`}>
              <div class="svc__media cover" data-reveal>
                <Picture src={c.image} alt={c.alt} widths={[480, 760, 1100]} sizes="(min-width: 900px) 50vw, 100vw" formats={['avif', 'webp']} />
              </div>
              <div class="svc__body">
                <h3 id={`${c.id}-t`}>{c.name}</h3>
                <p>{c.text}</p>
                <a class="link" href="/contact#enquiry">
                  Ask about {c.name.toLowerCase()}
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Process title="Our five-stage service" intro="Consultation, interior design, production, execution and after-sales service. One team, one point of contact." />

  <Packages tone="white" />

  <section class="section" aria-labelledby="faq-title">
    <div class="wrap faq">
      <div class="faq__intro">
        <h2 id="faq-title">Questions homeowners ask</h2>
        <p>Can’t find your answer? <a class="link" href="/contact">Ask us directly</a></p>
      </div>
      <div class="faq__list">
        {
          faqs.map((f) => (
            <details class="faq__item">
              <summary>
                <h3>{f.q}</h3>
                <span class="faq__icon" aria-hidden="true"><Icon name="plus" /></span>
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <ConsultBand image={photos.loungeDark} />
</Base>

<style>
  .svc {
    display: grid;
    gap: clamp(4rem, 3rem + 4vw, 8rem);
  }
  .svc__item {
    display: grid;
    gap: 2rem;
    align-items: center;
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  @media (min-width: 900px) {
    .svc__item {
      grid-template-columns: 1.15fr 0.85fr;
      gap: clamp(3rem, 7vw, 7rem);
    }
    .svc__item--flip {
      grid-template-columns: 0.85fr 1.15fr;
    }
    .svc__item--flip .svc__media {
      order: 2;
    }
  }
  .svc__media {
    aspect-ratio: 5 / 4;
  }
  .svc__body h3 {
    margin-bottom: 1.25rem;
    font-size: var(--fs-xl);
  }
  .svc__body p {
    max-width: 38ch;
    margin-bottom: 1.75rem;
    font-size: var(--fs-md);
    font-weight: 300;
    line-height: 1.6;
    color: var(--muted);
  }

  .faq {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 900px) {
    .faq {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 6rem;
    }
  }
  .faq__intro h2 {
    margin-bottom: 1.5rem;
  }
  .faq__intro p {
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }
  .faq__list {
    border-top: 1px solid var(--line);
  }
  .faq__item {
    border-bottom: 1px solid var(--line);
  }
  .faq__item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.5rem;
    cursor: pointer;
    list-style: none;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item h3 {
    font-size: var(--fs-md);
  }
  .faq__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--mocha);
    transition:
      transform 0.35s var(--ease),
      background-color 0.25s var(--ease);
  }
  .faq__icon :global(svg) {
    width: 18px;
    height: 18px;
  }
  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
    background: var(--mocha);
    color: var(--cream);
  }
  .faq__item p {
    margin: 0 0 1.75rem;
    font-weight: 300;
    color: var(--muted);
  }
</style>
