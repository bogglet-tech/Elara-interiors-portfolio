---
import Base from '../layouts/Base.astro';
---

<Base noindex title="Page not found" description="This page doesn't exist on the Elara Interiors website.">
  <section class="nf">
    <div class="wrap">
      <div class="nf__arch" aria-hidden="true"><span class="diamond"></span></div>
      <h1>This page doesn’t exist</h1>
      <p class="lede">The link may be old or mistyped. Try one of these instead.</p>
      <div class="actions">
        <a class="btn" href="/">Go to the home page</a>
        <a class="btn btn--ghost" href="/gallery">View the gallery</a>
        <a class="btn btn--ghost" href="/contact">Contact us</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding-block: clamp(3rem, 2rem + 6vw, 7rem) var(--section);
  }
  .nf__arch {
    position: relative;
    width: 90px;
    height: 120px;
    margin-bottom: 2rem;
    border: 1.5px solid var(--sand);
    border-bottom: 0;
    border-radius: 9999px 9999px 0 0;
  }
  .nf__arch .diamond {
    position: absolute;
    left: 50%;
    top: 55%;
    width: 14px;
    height: 14px;
    margin-left: -7px;
  }
  .nf h1 {
    margin-bottom: 1rem;
  }
  .nf .lede {
    margin-bottom: 2rem;
  }
</style>
